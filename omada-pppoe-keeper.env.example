# Kopieren nach /etc/omada-pppoe-keeper.env und danach: chmod 600 <datei>

# Omada-Controller (URL inkl. Port) und ein Benutzer mit Schreibrechten auf die Site
OMADA_URL=https://omada.example.com:8043
OMADA_USER=svc-watchdog
OMADA_PASSWORD=hier-passwort-eintragen
OMADA_SITE=Default

# Gateway (MAC wie im Controller angezeigt) und WAN-Port der PPPoE-Verbindung
OMADA_GW_MAC=AA-BB-CC-DD-EE-FF
OMADA_WAN_PORT=1

# 0 bei selbstsigniertem Zertifikat des Controllers
#OMADA_VERIFY_SSL=1

# Sekunden offline, bevor neu verbunden wird / Mindestabstand zwischen zwei Eingriffen
#DOWN_GRACE=180
#COOLDOWN=600

# Tägliche Zwangstrennung (HH:MM, leer = aus) und Zeitfenster in Minuten
#FORCE_AT=04:00
#FORCE_WINDOW=30

#STATE_FILE=/var/lib/omada-pppoe-keeper/state.json
